# GitLab CI for a Zeyn project (app or library).
# Private Zeyn libraries on the same GitLab instance are fetched with the job token:
# add this project to each library's "CI/CD > Job token permissions" allowlist.

image: rust:1.98

variables:
  CARGO_HOME: $CI_PROJECT_DIR/.cargo
  CARGO_NET_GIT_FETCH_WITH_CLI: "true"
  CARGO_TERM_COLOR: always

cache:
  key:
    files: [Cargo.lock]
  paths: [.cargo/registry, .cargo/git, target]

before_script:
  - git config --global url."https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/".insteadOf "https://${CI_SERVER_HOST}/"
  - git config --global --add url."https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/".insteadOf "ssh://git@${CI_SERVER_HOST}/"
  - rustup component add rustfmt clippy

stages: [check, test, release]

fmt:
  stage: check
  script: [cargo fmt --check]

clippy:
  stage: check
  script: [cargo clippy --all-targets -- -D warnings]

test:
  stage: test
  script: [cargo test]

tag-matches-version:
  stage: release
  rules:
    - if: $CI_COMMIT_TAG
  script:
    - VERSION=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
    - test "v$VERSION" = "$CI_COMMIT_TAG" || { echo "Tag $CI_COMMIT_TAG does not match Cargo.toml version $VERSION"; exit 1; }
