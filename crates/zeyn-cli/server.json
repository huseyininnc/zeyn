    "source": "github",
    "subfolder": "crates/zeyn-cli"
  },
  "version": "0.0.10",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "zeyn-cli",
      "version": "0.0.10",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
